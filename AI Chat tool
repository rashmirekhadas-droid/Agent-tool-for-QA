// server.js
const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');
const socketIO = require('socket.io');

const app = express();
app.use(cors());
app.use(express.json());

// MongoDB connection
mongoose.connect('mongodb://localhost:27017/customerApp', {
  useNewUrlParser: true,
  useUnifiedTopology: true
});

// Models
const Customer = require('./models/Customer');
const Message = require('./models/Message');

// Routes
app.post('/messages', async (req, res) => {
  const msg = new Message(req.body);
  await msg.save();
  res.json({ success: true });
});

app.get('/crm/:id', async (req, res) => {
  const customer = await Customer.findById(req.params.id);
  res.json(customer);
});

app.post('/campaigns', async (req, res) => {
  // Logic to send WhatsApp/Email/SMS campaign
  res.json({ success: true, campaignId: '12345' });
});

app.get('/analytics', async (req, res) => {
  // Return dummy analytics data
  res.json({ messagesSent: 1200, campaignsRun: 5, conversionRate: 0.12 });
});

const server = app.listen(5000, () => console.log('Server running on port 5000'));
const io = socketIO(server);

io.on('connection', (socket) => {
  console.log('New client connected');
  socket.on('sendMessage', (data) => {
    io.emit('newMessage', data);
  });
});
// App.js
import React, { useState, useEffect } from 'react';
import axios from 'axios';

function App() {
  const [messages, setMessages] = useState([]);
  const [analytics, setAnalytics] = useState({});

  useEffect(() => {
    axios.get('/analytics').then(res => setAnalytics(res.data));
  }, []);

  const sendMessage = async () => {
    const msg = { channel: 'WhatsApp', text: 'Hello Customer!' };
    await axios.post('/messages', msg);
    setMessages([...messages, msg]);
  };

  return (
    <div>
      <h1>Unified Customer Experience App</h1>
      <button onClick={sendMessage}>Send Test Message</button>
      <h2>Inbox</h2>
      <ul>
        {messages.map((m, i) => <li key={i}>{m.channel}: {m.text}</li>)}
      </ul>
      <h2>Analytics</h2>
      <p>Messages Sent: {analytics.messagesSent}</p>
      <p>Campaigns Run: {analytics.campaignsRun}</p>
      <p>Conversion Rate: {analytics.conversionRate}</p>
    </div>
  );
}

export default App;
